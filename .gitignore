__pycache__/
*.py[cod]

# Impeccable: platform-specific engine binary, re-downloaded (sha256-verified)
# on first run, so it must not be committed
.claude/skills/impeccable/scripts/bin/

# Claude Code machine-local settings; Impeccable installs its edit hook here
.claude/settings.local.json
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...sauf le gabarit, auquel le README renvoie : sans cette exception le
# lien est mort pour quiconque clone le dépôt, et personne ne sait quelles
# variables le site attend. Il ne contient que des exemples.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Captures produites par npm run verify
tests/__screenshots__/
