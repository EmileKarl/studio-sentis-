# Domaine public du site. Tant qu'il n'est pas défini :
#   - robots.txt interdit toute indexation ;
#   - chaque page porte noindex, nofollow ;
#   - le sitemap pointe vers example.invalid, un TLD réservé qui ne résout pas.
#
# C'est volontaire : un site indexé sous une fausse adresse doit ensuite être
# désindexé à la main, ce qui coûte plus cher que de ne pas être indexé.
#
# À définir sur l'hébergeur (Vercel : Settings > Environment Variables) avec le
# vrai domaine, sans barre oblique finale.
NEXT_PUBLIC_SITE_URL=https://votre-domaine.ca

# ---------------------------------------------------------------------------
# Identité de l'exploitant, affichée dans /mentions-legales.
#
# Tant qu'une de ces quatre valeurs manque, la page affiche le champ comme un
# trou explicite (« à compléter »), se déclare noindex à elle seule, et sort du
# sitemap. Un nom légal ou un NEQ ne s'invente pas : mieux vaut un document
# visiblement incomplet qu'un document faux et indexé.
#
# Le NEQ est attribué par le Registraire des entreprises du Québec lors de
# l'immatriculation ; l'hébergeur se remplit une fois le déploiement arrêté.
NEXT_PUBLIC_NOM_LEGAL="Raison sociale telle qu'immatriculée"
NEXT_PUBLIC_NEQ=1234567890
NEXT_PUBLIC_ADRESSE="123 rue Exemple, Châteauguay (Québec) J6J 0A0"
NEXT_PUBLIC_HEBERGEUR="Nom de l'hébergeur"
